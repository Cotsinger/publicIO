            "description": "该研究主题记录在 CORDIS 中的 RCN（Record Control Number）编号。"
          },
          {
            "api_name": "title",
            "display_name": "主题标题",
            "alias_table_name": null,
            "column_name": "title",
            "data_type": "STRING",
            "description": "研究主题的标题（title），即该主题的正式名称。"
          }
