{
  "cordis_classification": {
    "display_name": "CORDIS 科学分类本体",
    "description": "该本体面向欧盟 CORDIS 科研与创新信息平台的科学分类业务域，基于 EURIO 官方类目体系构建。覆盖研究主题（topics）、学科领域（subject areas）、ERC 学科评审组（erc panels）与 ERC 研究领域（erc research domains）等核心实体，并建模项目与主题、学科领域及 ERC 学科组的关联（project topics、project subject areas、project erc panels），为科研项目的学科归类、主题检索与 ERC 评审分组提供统一语义支撑。",
    "data_sources_info": {
      "cordis_temporary": {
        "data_source_type": "postgresql",
        "connection_string": null
      }
    },
