            "column_name": "code",
            "data_type": "STRING",
            "description": "研究主题（topic）的唯一代码标识，为本表主键。"
          },
          {
            "api_name": "rcn",
            "display_name": "RCN记录号",
            "alias_table_name": null,
            "column_name": "rcn",
