{
  "cordis_project": {
    "display_name": "CORDIS 项目与经费本体",
    "description": "本本体定位于欧盟科研资助管理领域，基于 EURIO 官方类目对 CORDIS（欧盟科研信息平台）中的项目与经费知识进行结构化建模。其覆盖范围包括科研项目（projects）、资助方式（funding schemes）、欧盟框架计划（ec framework programs）、经费计划（programmes）以及项目-经费计划关联（project programmes）等核心实体，完整刻画欧盟框架计划体系下科研项目从资助机制到经费归属的多层级语义关系。",
    "data_sources_info": {
